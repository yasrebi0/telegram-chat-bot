# توکن بات که از BotFather گرفتید
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# (اختیاری) برای امن‌تر شدن وبهوک؛ یک رشته‌ی دلخواه انتخاب کنید
TELEGRAM_WEBHOOK_SECRET=

# (اختیاری، رایگان) کلید API گوگل جمینای برای پاسخ‌های هوشمند
# از aistudio.google.com بدون نیاز به کارت اعتباری قابل دریافت است
# اگر خالی بگذارید، بات از پاسخ‌های ساده‌ی از پیش تعریف‌شده استفاده می‌کند
GEMINI_API_KEY=

# (اختیاری) مدل مورد استفاده
GEMINI_MODEL=gemini-2.5-flash-lite
